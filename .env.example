# LLM narration settings for run_pipeline.py / run_portfolio.py.
# Copy this file to .env and fill in your real API key. .env is gitignored.

LLM_PROVIDER=ollama
# Model name within that provider
LLM_MODEL=gpt-oss:latest
# Ollama (== Open WebUI, self-hosted gpt-oss)
OLLAMA_API_BASE=http://10.0.0.44:12000
# Open WebUI -> Settings -> Account -> API Keys -> Generate New API Key
OLLAMA_API_KEY=

# CouchDB admin credentials used by `docker compose up` (docker-compose.yml)
# to initialize the containerized CouchDB, and by the backend container to
# connect to it. Only used for `docker compose` — running the backend
# directly with `uvicorn` still reads COUCHDB_URL/USER/PASSWORD from this
# same file (pointed at whatever CouchDB instance you're using locally).
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme
